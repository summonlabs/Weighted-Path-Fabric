@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Threads)

include("${CMAKE_CURRENT_LIST_DIR}/WeightedPathFabricTargets.cmake")

set(WeightedPathFabric_VERSION "@PROJECT_VERSION@")
set(WeightedPathFabric_WIRE_PROTOCOL_VERSION "@WPF_WIRE_PROTOCOL_VERSION@")
set(WeightedPathFabric_PERSISTENCE_FORMAT_VERSION "@WPF_PERSISTENCE_FORMAT_VERSION@")

if(NOT TARGET SummonSoftwareLabs::WeightedPathFabric)
  set(${CMAKE_FIND_PACKAGE_NAME}_FOUND FALSE)
  set(${CMAKE_FIND_PACKAGE_NAME}_NOT_FOUND_MESSAGE
      "WeightedPathFabric package did not export the SummonSoftwareLabs::WeightedPathFabric target")
  return()
endif()

check_required_components(WeightedPathFabric)
